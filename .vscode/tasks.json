{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dirban: build extension",
      "type": "shell",
      "command": "bun run build",
      "options": {
        "cwd": "${workspaceFolder}/packages/vscode-extension"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$esbuild"]
    },
    {
      "label": "dirban: watch extension",
      "type": "shell",
      "command": "bun run watch",
      "options": {
        "cwd": "${workspaceFolder}/packages/vscode-extension"
      },
      "isBackground": true,
      "problemMatcher": ["$esbuild"]
    }
  ]
}
