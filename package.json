{
  "name": "dirban",
  "version": "0.1.3",
  "description": "Zero-Database, Agent-Native Kanban Engine & TUI Backed by the File System and Google Open Knowledge Format (OKF)",
  "type": "module",
  "main": "./dist/dirban.js",
  "bin": {
    "dirban": "dist/dirban.js"
  },
  "files": [
    "dist/dirban.js",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYip/dirban.git"
  },
  "keywords": [
    "kanban",
    "agentic",
    "ai-agents",
    "markdown",
    "git",
    "cli",
    "tui",
    "task-management"
  ],
  "author": "SYip",
  "license": "MIT",
  "scripts": {
    "dirban": "bun run main.ts",
    "build:cli": "bun build ./main.ts --target node --outfile dist/dirban.js",
    "build": "bun run build:cli && bun build ./main.ts --compile --outfile dirban && (command -v codesign > /dev/null 2>&1 && codesign --force --sign - dirban || true)",
    "prepack": "bun run build:cli",
    "install:local": "bun build ./main.ts --compile --outfile ~/.local/bin/dirban && (command -v codesign > /dev/null 2>&1 && codesign --force --sign - ~/.local/bin/dirban || true)",
    "build:extension": "bun --filter dirban-vscode build",
    "watch:extension": "bun --filter dirban-vscode watch",
    "package:extension": "bun --filter dirban-vscode package",
    "build:binaries": "bun run scripts/build-binaries.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && bun --filter dirban-vscode typecheck"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "neverthrow": "^8.2.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2"
  }
}
